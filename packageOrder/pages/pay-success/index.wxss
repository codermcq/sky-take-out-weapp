.success-page {
  min-height: 100vh;
  background: #fff;
  display: flex;
  flex-direction: column;
}

.success-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.success-icon {
  font-size: 140rpx;
}

.success-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #333;
  margin-top: 32rpx;
}

.success-desc {
  font-size: 28rpx;
  color: #999;
  margin-top: 16rpx;
}

.success-amount {
  font-size: 64rpx;
  font-weight: 700;
  color: #FF6B35;
  margin-top: 48rpx;
}

.success-no {
  font-size: 24rpx;
  color: #bbb;
  margin-top: 16rpx;
}

.success-actions {
  padding: 40rpx 64rpx;
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
}

.success-btn {
  margin-bottom: 24rpx;
}
