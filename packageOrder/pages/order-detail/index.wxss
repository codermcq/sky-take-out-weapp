.detail-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 60rpx;
}

/* ===== 顶部：状态 + 操作按钮（白底居中） ===== */
.detail-top {
  background: #fff;
  padding: 48rpx 32rpx 40rpx;
  text-align: center;
}

.detail-top-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.detail-top-sub {
  font-size: 26rpx;
  color: #999;
  margin-top: 16rpx;
}

.detail-top-btns {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-top: 36rpx;
}

.detail-pay-btn {
  background: rgb(255, 193, 7) !important;
  border-color: rgb(255, 193, 7) !important;
  color: #333 !important;
}

/* ===== 退款提示 ===== */
.detail-refund-bar {
  background: #FFF7F0;
  color: #FF6B35;
  font-size: 26rpx;
  text-align: center;
  padding: 20rpx 28rpx;
  margin: 0 24rpx;
  border-radius: 14rpx;
  border: 1rpx solid #FFE0CC;
}

/* ===== 内容区块 ===== */
.detail-section {
  background: #fff;
  border-radius: 20rpx;
  margin: 24rpx 24rpx 0;
  padding: 28rpx 28rpx 12rpx;
}

.detail-section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 12rpx;
  padding-left: 4rpx;
}

/* ===== 订单信息行 ===== */
.detail-info-row {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 4rpx;
  border-bottom: 1rpx solid #f7f7f7;
}

.detail-info-row:last-child {
  border-bottom: none;
}

.detail-info-label {
  font-size: 26rpx;
  color: #999;
  width: 140rpx;
  flex-shrink: 0;
}

.detail-info-value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
  word-break: break-all;
}

.detail-remark-text {
  color: #666;
  font-style: italic;
}

/* ===== 收货信息 ===== */
.detail-addr-row {
  display: flex;
  padding: 4rpx 4rpx 16rpx;
}

.detail-addr-icon {
  font-size: 36rpx;
  line-height: 1;
}

.detail-addr-info {
  flex: 1;
  margin-left: 16rpx;
}

.detail-addr-line1 {
  font-size: 28rpx;
  color: #1a1a1a;
  font-weight: 500;
}

.detail-addr-line2 {
  font-size: 26rpx;
  color: #666;
  margin-top: 10rpx;
  line-height: 1.4;
}

/* ===== 商品清单 ===== */
.detail-goods-row {
  display: flex;
  align-items: center;
  padding: 18rpx 4rpx;
  border-bottom: 1rpx solid #f7f7f7;
}

.detail-goods-row:last-child {
  border-bottom: none;
}

.detail-goods-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
  background: #f7f7f7;
}

.detail-goods-img-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.detail-goods-info {
  flex: 1;
  margin: 0 16rpx;
  min-width: 0;
}

.detail-goods-name {
  font-size: 28rpx;
  color: #1a1a1a;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.detail-goods-flavor {
  font-size: 22rpx;
  color: #aaa;
  margin-top: 6rpx;
}

.detail-goods-count {
  font-size: 24rpx;
  color: #999;
  margin-right: 20rpx;
}

.detail-goods-price {
  font-size: 28rpx;
  color: #1a1a1a;
  font-weight: 500;
}

/* ===== 金额明细 ===== */
.detail-fee-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 4rpx;
}

.detail-fee-label {
  font-size: 26rpx;
  color: #666;
}

.detail-fee-value {
  font-size: 26rpx;
  color: #333;
}

.detail-fee-total {
  border-top: 1rpx solid #eee;
  margin-top: 8rpx;
  padding-top: 22rpx;
}

.detail-fee-label--bold {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.detail-fee-value--bold {
  font-size: 32rpx;
  font-weight: 700;
  color: #FF6B35;
}

/* ===== 取消/拒单原因 ===== */
.detail-cancel-box {
  color: #999;
  font-size: 26rpx;
  text-align: center;
  padding: 22rpx 28rpx;
}

/* ===== 空态 ===== */
.detail-empty {
  padding-top: 160rpx;
}
