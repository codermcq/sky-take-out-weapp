.detail-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 60rpx;
}

/* 状态头 */
.detail-status {
  background: linear-gradient(180deg, #ff8a50 0%, #FF6B35 100%);
  padding: 48rpx 32rpx;
  border-radius: 0 0 32rpx 32rpx;
}

.detail-status-text {
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
}

.detail-status-sub {
  color: rgba(255, 255, 255, 0.9);
  font-size: 26rpx;
  margin-top: 12rpx;
}

/* 区块 */
.detail-section {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 8rpx 8rpx;
}

.detail-addr-row {
  display: flex;
  padding: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.detail-addr-icon {
  font-size: 40rpx;
}

.detail-addr-info {
  flex: 1;
  margin-left: 16rpx;
}

.detail-addr-line1 {
  font-size: 28rpx;
  color: #333;
}

.detail-addr-line2 {
  font-size: 26rpx;
  color: #666;
  margin-top: 8rpx;
}

.detail-remark {
  max-width: 300rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.detail-goods-title {
  font-size: 30rpx;
  font-weight: 600;
  padding: 16rpx 16rpx 0;
}

.detail-goods-row {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f7f7f7;
}

.detail-goods-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.detail-goods-info {
  flex: 1;
  margin: 0 16rpx;
  min-width: 0;
}

.detail-goods-name {
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.detail-goods-flavor {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.detail-goods-count {
  font-size: 24rpx;
  color: #666;
  margin-right: 16rpx;
}

.detail-goods-price {
  font-size: 26rpx;
  color: #333;
}

/* 金额 */
.detail-fee-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  color: #666;
}

.detail-fee-total {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  border-top: 1rpx solid #f5f5f5;
  padding-top: 20rpx;
}

/* 操作 */
.detail-actions {
  margin: 40rpx 32rpx;
}

.detail-action-btn {
  margin-bottom: 24rpx;
  border-radius: 12rpx !important;
}

.detail-action-row {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-top: 24rpx;
}

.detail-empty {
  padding-top: 100rpx;
}
