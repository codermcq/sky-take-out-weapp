.remark-page {
  min-height: 100vh;
  background: #f5f5f5;
}

.remark-box {
  margin: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  position: relative;
}

.remark-textarea {
  width: 100%;
  height: 240rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.remark-clear {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  font-size: 24rpx;
  color: #999;
}

.remark-count {
  text-align: right;
  color: #bbb;
  font-size: 24rpx;
  padding: 0 40rpx;
}

.remark-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
}
