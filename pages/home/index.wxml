<view class="home-page">
  <!-- 头部 -->
  <view class="home-header">
    <view class="home-header-inner" style="padding-top: {{statusBarHeight}}px;">
      <view class="home-shop-row">
        <view class="home-shop-name">苍穹外卖</view>
        <view class="home-shop-status {{shopStatus === 1 ? '' : 'is-closed'}}">{{shopStatus === 1 ? '营业中' : '休息中'}}</view>
        <view class="home-phone" bindtap="onCallPhone">📞</view>
      </view>
      <view class="home-personal" bindtap="onGoPersonal">
        <view class="home-personal-icon">👤</view>
        <view class="home-personal-text">个人中心</view>
        <view class="home-personal-arrow">›</view>
      </view>
    </view>
  </view>

  <!-- 内容 -->
  <view class="home-content">
    <scroll-view class="home-cats" scroll-y>
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="home-cat {{activeIndex === index ? 'home-cat-active' : ''}}"
        data-index="{{index}}"
        bindtap="onSelectCat"
      >
        <view class="home-cat-name">{{item.name}}</view>
        <view wx:if="{{item.type === 2}}" class="home-cat-tag">套餐</view>
      </view>
    </scroll-view>

    <scroll-view class="home-goods" scroll-y>
      <!-- 加载中 -->
      <view wx:if="{{categories.length && categories[activeIndex]._loading}}" class="home-goods-loading">加载中...</view>

      <!-- 已加载但无商品 -->
      <view wx:elif="{{categories.length && categories[activeIndex]._empty}}" class="home-goods-empty">本分类暂无商品</view>

      <!-- 有商品 -->
      <view wx:elif="{{categories.length && categories[activeIndex].items && categories[activeIndex].items.length}}">
        <block wx:for="{{categories[activeIndex].items}}" wx:key="id">
          <dish-item
            wx:if="{{categories[activeIndex].type === 1}}"
            dish="{{item}}"
            disabled="{{shopStatus !== 1}}"
            bind:detail="onOpenDetail"
            bind:flavor="onSelectFlavor"
            bind:add="onDishAdd"
          />
          <setmeal-item
            wx:else
            setmeal="{{item}}"
            disabled="{{shopStatus !== 1}}"
            bind:tap="onSetmealTap"
          />
        </block>
      </view>
    </scroll-view>
  </view>

  <!-- 底部购物车栏 -->
  <cart-bar
    total-price="{{totalAllPrice}}"
    total-count="{{allCount}}"
    visible="{{allCount > 0}}"
    disabled="{{shopStatus !== 1}}"
    bind:tap="onToggleCart"
    bind:settle="onCartSettle"
  />

  <!-- 购物车弹窗 -->
  <cart-popup
    show="{{cartVisible}}"
    cart-list="{{cartList}}"
    total-price="{{totalAllPrice}}"
    bind:close="onCloseCart"
    bind:change="onCartItemChange"
    bind:clear="onCartClear"
    bind:settle="onCartSettle"
  />

  <!-- 规格选择弹窗 -->
  <flavor-select-popup
    show="{{flavorVisible}}"
    dish="{{flavorDish}}"
    bind:close="onCloseFlavor"
    bind:confirm="onFlavorConfirm"
  />

  <!-- 套餐详情弹窗 -->
  <setmeal-popup
    show="{{setmealVisible}}"
    setmeal="{{currentSetmeal}}"
    bind:close="onCloseSetmeal"
    bind:add="onAddSetmeal"
  />

  <!-- 商品详情弹窗 -->
  <product-detail-popup
    show="{{detailVisible}}"
    dish="{{currentDish}}"
    count="{{countMap[currentDish.id] || 0}}"
    bind:close="onCloseDetail"
    bind:flavor="onSelectFlavor"
    bind:change="onDetailChange"
  />

  <!-- 拨打电话弹框 -->
  <van-popup show="{{phoneVisible}}" closeable position="bottom" round bind:close="onClosePhone">
    <view class="phone-popup">
      <view class="phone-popup-title">商家电话</view>
      <view class="phone-popup-num" bindtap="onPhoneConfirm">{{shopPhone}}</view>
      <view class="phone-popup-btn" bindtap="onPhoneConfirm">拨打电话</view>
      <view class="phone-popup-cancel" bindtap="onClosePhone">取消</view>
    </view>
  </van-popup>

  <!-- 打烊：透明层盖住购物车栏，拦截所有点击 -->
  <view wx:if="{{shopLoaded && shopStatus !== 1}}" class="closed-cart-overlay" catchtap="noop">
    <view class="closed-cart-tip">本店已打烊，暂不可点餐</view>
  </view>
</view>
