.profile-page {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 用户信息头 */
.profile-header {
  background: linear-gradient(180deg, #ff8a50 0%, #FF6B35 100%);
  border-radius: 0 0 32rpx 32rpx;
}

.profile-user {
  display: flex;
  align-items: center;
  padding: 48rpx 32rpx 64rpx;
}

.profile-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-avatar-img {
  width: 100%;
  height: 100%;
}

.profile-avatar-ph {
  font-size: 64rpx;
}

.profile-user-info {
  flex: 1;
  margin-left: 24rpx;
}

.profile-nickname {
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
}

.profile-desc {
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  margin-top: 8rpx;
}

.profile-logout {
  color: #fff;
  font-size: 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  padding: 8rpx 24rpx;
  border-radius: 28rpx;
}

/* 区块 */
.profile-section {
  background: #fff;
  margin-top: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx 24rpx 12rpx;
}

.profile-section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
  padding: 0 8rpx;
}

/* 订单入口 */
.profile-order-tabs {
  display: flex;
  padding: 20rpx 0;
}

.profile-order-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.profile-order-icon {
  font-size: 48rpx;
}

.profile-order-text {
  font-size: 24rpx;
  color: #666;
  margin-top: 12rpx;
}
