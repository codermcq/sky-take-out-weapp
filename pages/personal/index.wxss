.personal-page {
  min-height: 100vh;
}

/* 用户信息区域 */
.personal-header {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #fff;
}

.personal-avatar-btn {
  width: 96rpx;
  height: 96rpx;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 50%;
  overflow: hidden;
  background: #f0f0f0;
  flex-shrink: 0;
  line-height: 1;
}

.personal-avatar-btn::after {
  display: none;
}

.personal-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: block;
}

.personal-avatar-ph {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #ccc;
}

.personal-info {
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.personal-nickname {
  font-size: 32rpx;
  color: #333;
  background: none;
  min-height: 48rpx;
  line-height: 48rpx;
  width: 400rpx;
}

.personal-nickname::placeholder {
  color: #999;
}

.personal-phone {
  font-size: 26rpx;
  color: #999;
  line-height: 36rpx;
}

/* 菜单 */
.personal-group {
  margin-top: 34rpx;
}
