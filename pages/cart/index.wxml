<view class="cart-page">
  <nav-bar title="购物车" show-back="{{false}}" />

  <!-- 未登录 -->
  <block wx:if="{{!loggedIn}}">
    <empty-view type="order" text="登录后查看购物车" btn-text="去登录" bind:btn="onGoLogin" />
  </block>

  <!-- 空购物车 -->
  <block wx:elif="{{!cartList.length}}">
    <empty-view type="order" text="购物车是空的，去点餐吧" btn-text="去点餐" bind:btn="onGoHome" />
  </block>

  <!-- 购物车列表 -->
  <block wx:else>
    <view class="cart-list">
      <van-swipe-cell wx:for="{{cartList}}" wx:key="id" right-width="{{64}}">
        <view class="cart-item" bindtap="onToggleSelect" data-id="{{item.id}}">
          <view class="cart-check {{selectedMap[item.id] ? 'cart-check-on' : ''}}" catchtap="onToggleSelect" data-id="{{item.id}}">
            <view class="cart-check-dot"></view>
          </view>
          <image wx:if="{{item.image}}" class="cart-item-img" src="{{item.image}}" mode="aspectFill" />
          <view wx:else class="cart-item-img cart-item-img-ph">🍽</view>
          <view class="cart-item-info">
            <view class="cart-item-name">{{item.name}}</view>
            <view wx:if="{{item.dishFlavor}}" class="cart-item-flavor">{{item.dishFlavor}}</view>
            <view class="cart-item-price">¥{{item.amount}}</view>
          </view>
          <van-stepper
            value="{{item.number}}"
            min="1"
            integer
            disable-input
            button-size="28"
            theme="round"
            data-id="{{item.id}}"
            bind:change="onStepperChange"
          />
        </view>
        <view slot="right" class="cart-swipe-del" data-id="{{item.id}}" bindtap="onDelete">删除</view>
      </van-swipe-cell>
    </view>

    <!-- 底部结算栏 -->
    <view class="cart-footer">
      <view class="cart-footer-left" bindtap="onToggleAll">
        <view class="cart-check {{allSelected ? 'cart-check-on' : ''}}" catchtap="onToggleAll">
          <view class="cart-check-dot"></view>
        </view>
        <text>全选</text>
      </view>
      <view class="cart-footer-total">
        <text class="cart-footer-label">合计：</text>
        <text class="cart-footer-price">¥{{totalPrice}}</text>
      </view>
      <view class="cart-footer-settle" bindtap="onSettle">去结算({{totalCount}})</view>
    </view>
  </block>
</view>
