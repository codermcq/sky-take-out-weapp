:host {
  display: block;
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(env(safe-area-inset-bottom) + 24rpx);
  z-index: 100;
}

.cart-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  background: #333;
  border-radius: 40rpx;
  padding: 0 0 0 16rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.2);
}

.cart-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.cart-icon-wrap {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cart-icon {
  font-size: 44rpx;
  color: #fff;
}

.cart-badge {
  position: absolute;
  top: -2rpx;
  right: -6rpx;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  text-align: center;
  background: #FF6B35;
  color: #fff;
  font-size: 18rpx;
  border-radius: 14rpx;
  padding: 0 6rpx;
}

.cart-total {
  display: flex;
  align-items: baseline;
  margin-left: 8rpx;
  min-width: 0;
}

.cart-total-label {
  color: #fff;
  font-size: 22rpx;
  margin-right: 6rpx;
}

.cart-total-price {
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

.cart-right {
  height: 72rpx;
  margin: 4rpx;
  padding: 0 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #555;
  color: #fff;
  font-size: 26rpx;
  border-radius: 36rpx;
}

.cart-right-active {
  background: #FF6B35;
}
