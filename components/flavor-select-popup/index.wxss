.flavor-popup {
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.flavor-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flavor-title {
  font-size: 32rpx;
  font-weight: 600;
}

.flavor-close {
  font-size: 32rpx;
  color: #999;
  padding: 8rpx;
}

.flavor-body {
  max-height: 50vh;
  margin-top: 24rpx;
}

.flavor-group {
  margin-bottom: 24rpx;
}

.flavor-group-name {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.flavor-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.flavor-option {
  padding: 12rpx 32rpx;
  background: #f5f5f5;
  color: #333;
  font-size: 26rpx;
  border-radius: 32rpx;
}

.flavor-option-active {
  background: #fff0e8;
  color: #FF6B35;
  border: 1rpx solid #FF6B35;
}

.flavor-footer {
  margin-top: 24rpx;
}
