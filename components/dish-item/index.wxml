<view class="dish-item {{disabled ? 'is-disabled' : ''}}">
  <image wx:if="{{dish.image}}" class="dish-img" src="{{dish.image}}" mode="aspectFill" bindtap="onTapItem" />
  <view wx:else class="dish-img dish-img-placeholder" bindtap="onTapItem">🍽</view>
  <view class="dish-info">
    <view class="dish-name" bindtap="onTapItem">{{dish.name}}</view>
    <view class="dish-desc" bindtap="onTapItem">{{dish.description || dish.name}}</view>
    <view class="dish-bottom">
      <view class="dish-price">¥{{dish.price}}</view>
      <!-- 有口味：选择规格 -->
      <view wx:if="{{dish.flavors && dish.flavors.length}}" class="dish-flavor-btn" bindtap="onSelectFlavor">选择规格</view>
      <!-- 无口味：直接加购 -->
      <view wx:else class="dish-add-btn" bindtap="onAdd">＋</view>
    </view>
  </view>
</view>
