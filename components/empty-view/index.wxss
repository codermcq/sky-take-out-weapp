:host {
  display: block;
}

.empty-view {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  line-height: 1;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.empty-btn {
  margin-top: 32rpx;
  padding: 16rpx 56rpx;
  background: #FFB800;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
}
