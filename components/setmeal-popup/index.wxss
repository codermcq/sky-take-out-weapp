.sm-popup {
  padding: 32rpx;
}

.sm-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.sm-header-info {
  flex: 1;
  min-width: 0;
}

.sm-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
}

.sm-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.sm-close {
  font-size: 32rpx;
  color: #999;
  padding: 4rpx 8rpx;
  flex-shrink: 0;
}

.sm-image-area {
  position: relative;
  margin-top: 24rpx;
}

.sm-image {
  width: 100%;
  height: 300rpx;
  border-radius: 16rpx;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 100rpx;
}

.sm-price-tag {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  background: #FFB800;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
}

.sm-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin: 24rpx 0 16rpx;
}

.sm-dish-scroll {
  white-space: nowrap;
}

.sm-dish-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 180rpx;
  margin-right: 20rpx;
}

.sm-dish-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
}

.sm-dish-name {
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
  margin-top: 12rpx;
  max-width: 180rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.sm-dish-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
  max-width: 180rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.sm-dish-copies {
  font-size: 22rpx;
  color: #FFB800;
  margin-top: 6rpx;
}

.sm-footer {
  margin-top: 32rpx;
}
