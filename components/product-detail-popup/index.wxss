.detail-popup {
  padding-bottom: env(safe-area-inset-bottom);
}

.detail-img {
  width: 100%;
  height: 360rpx;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 120rpx;
}

.detail-body {
  padding: 32rpx;
}

.detail-close {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.4);
  color: #fff;
  border-radius: 50%;
  font-size: 24rpx;
}

.detail-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
}

.detail-desc {
  font-size: 26rpx;
  color: #666;
  margin-top: 16rpx;
  line-height: 1.6;
}

.detail-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 32rpx;
}

.detail-price {
  color: #FF6B35;
  font-size: 40rpx;
  font-weight: 700;
}

.detail-flavor-btn {
  padding: 10rpx 32rpx;
  background: #FF6B35;
  color: #fff;
  font-size: 24rpx;
  border-radius: 30rpx;
}

.detail-tip {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 24rpx;
}
