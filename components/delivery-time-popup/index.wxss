.time-popup {
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.time-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.time-title {
  font-size: 32rpx;
  font-weight: 600;
}

.time-close {
  font-size: 32rpx;
  color: #999;
  padding: 8rpx;
}

.time-date-tabs {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.time-date-tab {
  padding: 12rpx 32rpx;
  background: #f5f5f5;
  color: #333;
  font-size: 26rpx;
  border-radius: 32rpx;
}

.time-date-tab-active {
  background: #FF6B35;
  color: #fff;
}

.time-slot-list {
  max-height: 40vh;
  margin-top: 24rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.time-slot {
  width: calc((100% - 64rpx) / 4);
  margin: 8rpx;
  padding: 20rpx 0;
  text-align: center;
  background: #f5f5f5;
  color: #333;
  font-size: 26rpx;
  border-radius: 16rpx;
}

.time-slot-active {
  background: #fff0e8;
  color: #FF6B35;
  border: 1rpx solid #FF6B35;
}

.time-footer {
  margin-top: 24rpx;
}
