.search-page {
  min-height: 100vh;
  background: #f5f5f5;
}

.search-nav {
  display: flex;
  align-items: center;
  background: #FF6B35;
  padding: 12rpx 0;
  padding-top: calc(env(safe-area-inset-top) + 20rpx);
}

.search-nav van-search {
  flex: 1;
}

.search-cancel {
  color: #fff;
  font-size: 28rpx;
  padding: 0 24rpx;
  white-space: nowrap;
}

.search-result-info {
  padding: 20rpx 32rpx 0;
  font-size: 24rpx;
  color: #999;
}

.search-list {
  padding: 20rpx;
}

.search-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.search-item-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

.search-item-info {
  flex: 1;
  margin: 0 16rpx;
  min-width: 0;
}

.search-item-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}

.search-item-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.search-item-price {
  font-size: 30rpx;
  color: #FF6B35;
  font-weight: 700;
  margin-top: 8rpx;
}

.search-item-add {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  background: #FF6B35;
  color: #fff;
  font-size: 36rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
