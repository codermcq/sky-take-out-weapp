<view class="search-page">
  <view class="search-nav">
    <van-search
      value="{{keyword}}"
      placeholder="搜索菜品名称/描述"
      show-action
      focus
      background="#FF6B35"
      shape="round"
      bind:input="onInput"
      bind:clear="onClear"
    />
    <view class="search-cancel" bindtap="onClear">取消</view>
  </view>

  <van-loading wx:if="{{!loaded}}" custom-style="margin: 120rpx auto;" />

  <block wx:else>
    <view wx:if="{{keyword}}" class="search-result-info">共找到 {{results.length}} 个结果</view>

    <view wx:if="{{results.length}}" class="search-list">
      <view wx:for="{{results}}" wx:key="id" class="search-item">
        <image wx:if="{{item.image}}" class="search-item-img" src="{{item.image}}" mode="aspectFill" />
        <view wx:else class="search-item-img search-item-img-ph">🍽</view>
        <view class="search-item-info">
          <view class="search-item-name">{{item.name}}</view>
          <view class="search-item-desc">{{item.description || item.name}}</view>
          <view class="search-item-price">¥{{item.price}}</view>
        </view>
        <view class="search-item-add" data-id="{{item.id}}" bindtap="onAdd">＋</view>
      </view>
    </view>

    <empty-view wx:else type="default" text="{{keyword ? '未找到相关菜品' : '输入关键词搜索菜品'}}" />
  </block>
</view>
