.edit-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 60rpx;
}

.edit-group {
  margin-top: 20rpx;
}

.edit-section {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}

.edit-section-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.edit-labels {
  display: flex;
  gap: 16rpx;
}

.edit-label {
  padding: 12rpx 40rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 26rpx;
  border-radius: 32rpx;
}

.edit-label-active {
  background: #fff0e8;
  color: #FF6B35;
  border: 1rpx solid #FF6B35;
}

.edit-default {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.edit-default-text {
  font-size: 28rpx;
  color: #333;
}

.edit-actions {
  margin: 40rpx 32rpx;
}

.edit-save-btn {
  border-radius: 44rpx;
}
