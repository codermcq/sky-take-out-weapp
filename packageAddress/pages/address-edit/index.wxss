.edit-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 60rpx;
}

.edit-group {
  margin-top: 20rpx;
}

/* 联系人 + 性别 */
.edit-contact-row {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #fff;
}

.edit-contact-label {
  font-size: 28rpx;
  color: #333;
  width: 6.2em;
  flex-shrink: 0;
}

.edit-contact-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  min-width: 0;
  margin-right: 20rpx;
}

.edit-sex {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.edit-sex + .edit-sex {
  margin-left: 12rpx;
}

.edit-sex-active {
  color: #FFB800;
  background: #fff8e8;
  border: 1rpx solid #FFB800;
}

.edit-section {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}

.edit-section-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.edit-labels {
  display: flex;
  gap: 16rpx;
}

.edit-label {
  padding: 12rpx 40rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 26rpx;
  border-radius: 32rpx;
}

.edit-label-active {
  background: #fff0e8;
  color: #FF6B35;
  border: 1rpx solid #FF6B35;
}

.edit-default {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.edit-default-text {
  font-size: 28rpx;
  color: #333;
}

.edit-actions {
  margin: 40rpx 32rpx;
}

.edit-save-btn {
  border-radius: 12rpx !important;
}
