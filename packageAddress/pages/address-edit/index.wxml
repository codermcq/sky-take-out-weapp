<view class="edit-page">
  <nav-bar title="{{editId ? '编辑地址' : '新增地址'}}" />

  <van-cell-group inset custom-class="edit-group">
    <view class="edit-contact-row">
      <view class="edit-contact-label">联系人</view>
      <input class="edit-contact-input" value="{{consignee}}" placeholder="请输入（最多12字）" maxlength="12" bindinput="onNameInput" />
      <view class="edit-sex {{sex === 1 ? 'edit-sex-active' : ''}}" data-sex="1" catchtap="onSexChange">先生</view>
      <view class="edit-sex {{sex === 0 ? 'edit-sex-active' : ''}}" data-sex="0" catchtap="onSexChange">女士</view>
    </view>
    <van-field
      label="手机号"
      value="{{phone}}"
      type="number"
      maxlength="11"
      placeholder="请输入手机号"
      input-align="left"
      bind:change="onPhoneInput"
    />
    <van-field
      label="省市区"
      value="{{provinceName}}{{cityName}}{{districtName}}"
      placeholder="请选择省市区"
      is-link
      readonly
      input-align="left"
      bind:tap="onOpenRegion"
    />
    <van-field
      label="详细地址"
      value="{{detail}}"
      type="textarea"
      autosize
      placeholder="街道、楼牌号等"
      input-align="left"
      bind:change="onDetailInput"
    />
  </van-cell-group>

  <!-- 标签 -->
  <view class="edit-section">
    <view class="edit-section-label">标签</view>
    <view class="edit-labels">
      <view
        wx:for="{{labels}}"
        wx:key="*this"
        class="edit-label {{label === item ? 'edit-label-active' : ''}}"
        data-label="{{item}}"
        bindtap="onSelectLabel"
      >{{item}}</view>
    </view>
  </view>

  <!-- 操作 -->
  <view class="edit-actions">
    <van-button type="primary" block custom-class="edit-save-btn" bind:click="onSave">保存地址</van-button>
    <van-button wx:if="{{editId}}" block custom-style="margin-top:20rpx;color:#ee0a24;border-color:#ee0a24;border-radius:12rpx;" bind:click="onDelete">删除地址</van-button>
  </view>

  <region-picker
    show="{{regionVisible}}"
    value="{{regionValue}}"
    bind:close="onCloseRegion"
    bind:confirm="onRegionConfirm"
  />
</view>
